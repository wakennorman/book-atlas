{
  "name": "book-atlas",
  "version": "0.73",
  "private": true,
  "type": "module",
  "description": "书脉 BookAtlas · 人物关系与事件图谱",
  "scripts": {
    "lint": "eslint js/ miniprogram/utils/ miniprogram/pages/ scripts/ shared/ test/ --ext .js,.mjs",
    "test": "node test/smoke.mjs && node test/core.mjs",
    "test:e2e": "node test/e2e.mjs",
    "build": "esbuild js/app.js js/editor.js js/export.js js/ai.js --minify --outdir=dist/js --out-extension:.js=.min.js",
    "build:css": "esbuild css/style.css css/editor.css --minify --outdir=dist/css"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0"
  }
}
