page { height: 100%; }
.page { display: flex; flex-direction: column; height: 100vh; }

/* 顶部工具栏：横向可滑 */
.topbar {
  display: flex; gap: 8rpx; padding: 12rpx 16rpx; overflow-x: auto;
  background: #fff; border-bottom: 1rpx solid #e5dfd3; white-space: nowrap;
}
.pill {
  flex: none; border: 1rpx solid #e5dfd3; border-radius: 999rpx; background: #faf8f3;
  padding: 10rpx 20rpx; font-size: 24rpx; color: #232a35;
}
.pill.on { border-color: #1b2233; box-shadow: inset 0 0 0 2rpx #1b2233; }
.pill.small { padding: 8rpx 16rpx; font-size: 22rpx; }
.pill-in { display: inline-block; }

/* 章节条 */
.chapterbar { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 16rpx; background: #faf8f3; border-bottom: 1rpx solid #e5dfd3; flex-wrap: wrap; }
.cbtn { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border: 1rpx solid #e5dfd3; border-radius: 50%; background: #fff; }
.ctext { font-size: 26rpx; font-weight: 600; padding: 0 8rpx; }
.ctext .more { font-weight: 400; font-size: 22rpx; color: #6c7482; }
.timebar { padding: 4rpx 16rpx 8rpx; background: #faf8f3; border-bottom: 1rpx solid #e5dfd3; }
.tslider { margin: 0 8rpx; }
.thint { font-size: 20rpx; color: #6c7482; }

/* 搜索 / 两人关系 */
.searchbar { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 16rpx; background: #fff; border-bottom: 1rpx solid #e5dfd3; }
.sinput { flex: 1 1 auto; height: 64rpx; padding: 0 22rpx; border: 1rpx solid #e5dfd3; border-radius: 999rpx; background: #faf8f3; font-size: 25rpx; }
.pathbar { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 16rpx; background: #faf8f3; border-bottom: 1rpx solid #e5dfd3; flex-wrap: wrap; }
.arrow { color: #6c7482; font-size: 24rpx; }
.pathbar .hint { font-size: 22rpx; }
.idx { width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center; border-radius: 50%; background: #efeae0; color: #6c7482; font-size: 21rpx; margin-right: 8rpx; }
.pick-list { max-height: 50vh; overflow: auto; margin-top: 12rpx; }
.pick-item { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 8rpx; border-bottom: 1rpx solid #efeae0; font-size: 27rpx; }
.pick-item .deg { font-size: 22rpx; color: #6c7482; }
.pathbar .sinput { margin-top: 12rpx; }
.chk { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; padding: 10rpx 0; }

/* 画布 */
.canvas { flex: 1 1 auto; width: 100%; height: 100%; background: #f4f1ea; }

/* 底部面板 */
.sheet {
  max-height: 62vh; overflow: auto; background: #fff; border-top: 1rpx solid #e5dfd3;
  padding: 20rpx 24rpx 40rpx; box-shadow: 0 -6rpx 24rpx rgba(24, 28, 38, .08);
}
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border: 1rpx solid #e5dfd3; border-radius: 50%; color: #6c7482; }
.sheet-sub { font-size: 24rpx; color: #6c7482; margin-top: 4rpx; }
.aliases { font-size: 24rpx; color: #6c7482; margin-top: 8rpx; }
.desc { font-size: 26rpx; margin-top: 10rpx; line-height: 1.6; }
.fate { font-size: 24rpx; color: #6c7482; margin-top: 8rpx; }
.h3 { font-size: 26rpx; font-weight: 700; margin: 20rpx 0 8rpx; }
.life-item, .rel { font-size: 25rpx; padding: 8rpx 0; border-bottom: 1rpx dashed #efeae0; }
.rel-head { display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.rel-head .type { color: #6c7482; font-weight: 400; }
.ev { font-size: 23rpx; color: #6c7482; margin-top: 4rpx; }
.ch { font-size: 21rpx; background: #efeae0; border-radius: 6rpx; padding: 2rpx 8rpx; margin-right: 8rpx; }
.badge { font-size: 21rpx; background: #efeae0; color: #6c7482; border-radius: 6rpx; padding: 2rpx 8rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 8rpx; }
.chip { font-size: 23rpx; border: 1rpx solid #e5dfd3; background: #faf8f3; border-radius: 999rpx; padding: 4rpx 14rpx; }
.chip.on { border-color: #1b2233; box-shadow: inset 0 0 0 2rpx #1b2233; }
.hint { font-size: 23rpx; color: #6c7482; margin-top: 8rpx; }
.locked { font-size: 26rpx; padding: 16rpx; background: #faf8f3; border: 1rpx dashed #e5dfd3; border-radius: 12rpx; }
